# Supabase project credentials (copy from your project's API settings)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# Paste the public key here for the client-side push subscription
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# Set the private key and subject in Supabase Edge Function environment variables
# (Dashboard → Edge Functions → send-push → Environment variables):
#   VAPID_PUBLIC_KEY=same-public-key
#   VAPID_PRIVATE_KEY=your-vapid-private-key
#   VAPID_SUBJECT=mailto:you@yourdomain.com
